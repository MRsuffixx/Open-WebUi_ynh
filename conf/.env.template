# Open WebUI Environment Configuration
# Generated by YunoHost installer

# =============================================================================
# CORE SETTINGS
# =============================================================================

# Application mode - keep as production
APP_MODE=production

# Data directory - maps to /home/yunohost.app/{app}
DATA_DIR=__DATA_DIR__

# Enable verbose logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
GLOBAL_LOG_LEVEL=INFO

# Secret key for session encryption (should be randomly generated)
# This will be auto-generated if not set
# SECRET_KEY=changeme

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Host and port - MUST match systemd.service and nginx.conf
HOST=127.0.0.1
PORT=__PORT__

# Number of uvicorn workers (set in systemd.service ExecStart)
# Keep at 4 for normal operation, use 1 during migrations

# =============================================================================
# AUTHENTICATION - SSOwat/LDAP INTEGRATION
# =============================================================================

# Enable authentication
WEBUI_AUTH=True

# Trust proxy headers for SSO authentication
WEBUI_AUTH_TRUSTED_EMAIL_HEADER=Remote-User
WEBUI_AUTH_TRUSTED_NAME_HEADER=Remote-Name
WEBUI_AUTH_TRUSTED_GROUP_HEADER=Remote-Group

# Force authentication (users must login via SSO/LDAP)
WEBUI_AUTH_FORCE_SESSION=True

# Disable default admin account creation
WEBUI_AUTH_SIGNUP_ENABLED=False
WEBUI_AUTH_SIGNUP_ALLOWED_DOMAINS=""

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# SQLite database location (relative to DATA_DIR)
DATABASE_URL=sqlite:///__DATA_DIR__/webui.db

# Database pool settings
DB_ENGINE=sqlite
DB_MAX_OVERFLOW=10
DB_POOL_SIZE=5

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# App title and branding
APP_TITLE=Open WebUI
APP_DESCRIPTION=Self-hosted AI Interface

# Enable admin panel
ADMIN_UI_ENABLED=True

# Default theme
DEFAULT_USER_ROLE=admin

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allow CORS from the YunoHost domain only
CORS_ALLOWED_ORIGINS=https://__DOMAIN__

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Upload folder for models and files
UPLOAD_DIR=__DATA_DIR__/uploads

# Models cache directory
MODELS_DIR=__DATA_DIR__/models

# Enable file management
FILE_SIZE_LIMIT=10G
FILE_ALLOWED_EXTENSIONS=".pdf,.txt,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.csv,.md,.json,.yaml,.yml,.html,.js,.css,.py,.sh,.log,.zip,.tar,.gz"

# =============================================================================
# OLLAMA CONFIGURATION (if using local models)
# =============================================================================

# Default Ollama endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Enable Ollama integration
ENABLE_OLLAMA=True
OLLAMA_API_BASE_URL=http://localhost:11434/v1

# =============================================================================
# OPENAI API CONFIGURATION
# =============================================================================

# OpenAI API key (users should configure their own)
# OPENAI_API_KEY=

# Default API base URL
OPENAI_API_BASE_URL=https://api.openai.com/v1

# =============================================================================
# WEBHOOKS & INTEGRATIONS
# =============================================================================

# Enable webhook support
ENABLE_WEBHOOKS=False

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Request timeout (seconds)
REQUEST_TIMEOUT=300

# Max concurrent requests
MAX_CONCURRENT_REQUESTS=10

# =============================================================================
# SECURITY HARDENING
# =============================================================================

# Enable security headers
ENABLE_SECURITY_HEADERS=True

# Disable telemetry
ENABLE_TELEMETRY=False

# Enable rate limiting
ENABLE_RATE_LIMITING=True
RATE_LIMIT_PER_USER=100
RATE_LIMIT_WINDOW_SECONDS=60