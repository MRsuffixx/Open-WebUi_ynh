#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# MANAGE FAILURE OF THE SCRIPT
#=================================================

# Exit on error
ynh_abort_if_errors

#=================================================
# RETRIEVE ARGUMENTS FROM THE MANIFEST
#=================================================

# Settings are automatically loaded as bash variables:
# - $domain
# - $path
# - $admin
# - $install_dir
# - $port
# - $data_dir

app=$YNH_APP_INSTANCE_NAME

#=================================================
# INITIALIZE THE DATA DIRECTORY
#=================================================

# The data directory will be created by the resources system
# but we need to ensure proper ownership and permissions
ynh_script_progression "Setting up data directory..."

# Data directory is automatically provisioned by YunoHost
# Additional subdirectories for Open WebUI
mkdir -p "$data_dir/uploads"
mkdir -p "$data_dir/models"

# Ensure proper ownership - Open WebUI needs write access to data directory
chown -R "$app:$app" "$data_dir"

#=================================================
# CREATE VIRTUAL ENVIRONMENT
#=================================================

ynh_script_progression "Creating Python virtual environment..."

# Create the venv in the install directory
# YunoHost resources create install_dir at /opt/$app
python3 -m venv "$install_dir/venv"

# Upgrade pip to the latest version
"$install_dir/venv/bin/pip" install --upgrade pip wheel setuptools

#=================================================
# CREATE INITIAL INSTALLATION SCRIPT
#=================================================

# We create a separate installation script that handles the pip install
# This allows the main YunoHost API to return quickly
cat > "$install_dir/install_packages.sh" << 'SCRIPT_EOF'
#!/bin/bash

# Installation script for Open WebUI
# This runs in background to avoid YunoHost API timeout

APP="$1"
INSTALL_DIR="$2"
LOG_FILE="/var/log/$APP/install.log"
ERROR_LOG="/var/log/$APP/install.err.log"

# Ensure log directory exists
mkdir -p "/var/log/$APP"

# Start installation
echo "$(date): Starting Open WebUI installation..." >> "$LOG_FILE"
"$INSTALL_DIR/venv/bin/pip" install --no-cache-dir open-webui >> "$LOG_FILE" 2>> "$ERROR_LOG"

if [ $? -eq 0 ]; then
    echo "$(date): Open WebUI installation completed successfully" >> "$LOG_FILE"
    # Touch a flag file to indicate installation is complete
    touch "$INSTALL_DIR/.installed"
else
    echo "$(date): Open WebUI installation FAILED" >> "$LOG_FILE"
    echo "Check $ERROR_LOG for details" >> "$LOG_FILE"
fi
SCRIPT_EOF

chmod +x "$install_dir/install_packages.sh"

# Start the installation in background
# This prevents the YunoHost API from timing out
nohup "$install_dir/install_packages.sh" "$app" "$install_dir" > /dev/null 2>&1 &

# Record the background process PID
echo $! > "$install_dir/.install_pid"

# Report progress immediately to prevent API timeout
ynh_script_progression "Installing Open WebUI in background..."
ynh_print_info "Open WebUI installation is running. This may take 5-10 minutes."
ynh_print_info "You can monitor progress with: tail -f /var/log/$app/install.log"

# Check if the installation is still running after a short delay
sleep 3
if [ -f "$install_dir/.installed" ]; then
    ynh_script_progression "Installation already completed!"
else
    ynh_script_progression "Installation started in background..."
    # Continue to next steps - the service won't start yet
    # The upgrade script will handle waiting for installation to complete
fi

#=================================================
# CREATE THE .env CONFIGURATION FILE
#=================================================

ynh_script_progression "Configuring Open WebUI..."

# Generate the .env file from template
# This will replace __DATA_DIR__, __PORT__, __DOMAIN__ placeholders
ynh_config_add --template=".env.template" --destination="$install_dir/.env"

# Ensure .env has proper permissions
chmod 600 "$install_dir/.env"
chown "$app:$app" "$install_dir/.env"

#=================================================
# CREATE LOG DIRECTORY
#=================================================

ynh_script_progression "Creating log directory..."

mkdir -p "/var/log/$app"
chown -R "$app:$app" "/var/log/$app"
chmod 755 "/var/log/$app"

#=================================================
# SETUP SYSTEM CONFIGURATION
#=================================================

ynh_script_progression "Setting up system configurations..."

# Configure Nginx as reverse proxy (with WebSocket support)
ynh_config_add_nginx

# Configure systemd service
ynh_config_add_systemd

# Add the service to YunoHost's service management
yunohost service add "$app" \
    --description="Open WebUI - Self-hosted AI Interface" \
    --log="/var/log/$app/open-webui.log" \
    --needs_exposed_ports "$port"

# Configure logrotate for application logs
ynh_config_add_logrotate

#=================================================
# WAIT FOR INSTALLATION TO COMPLETE
#=================================================

ynh_script_progression "Waiting for Open WebUI installation to complete..."

# Wait for the background installation to complete
max_wait=600  # 10 minutes max
waited=0
interval=10

while [ $waited -lt $max_wait ]; do
    if [ -f "$install_dir/.installed" ]; then
        ynh_script_progression "Open WebUI installation completed!"
        break
    fi
    
    # Check if installation process is still running
    if [ -f "$install_dir/.install_pid" ]; then
        pid=$(cat "$install_dir/.install_pid")
        if ! kill -0 "$pid" 2>/dev/null; then
            # Process ended but no .installed file - check for errors
            if [ -f "$install_dir/install.err.log" ] && grep -q "ERROR" "$install_dir/install.err.log" 2>/dev/null; then
                ynh_die "Open WebUI installation failed. Check /var/log/$app/install.err.log"
            fi
            # If no error found, installation might have completed
            break
        fi
    fi
    
    ynh_print_info "Waiting for installation... ($waited/$max_wait seconds)"
    sleep $interval
    waited=$((waited + interval))
done

# Final check
if [ ! -f "$install_dir/.installed" ]; then
    ynh_print_warn "Installation may still be in progress."
    ynh_print_warn "Check status with: tail -f /var/log/$app/install.log"
fi

#=================================================
# CLEANUP TEMPORARY FILES
#=================================================

# Remove temporary installation script
rm -f "$install_dir/install_packages.sh"
rm -f "$install_dir/.install_pid"

#=================================================
# START THE APPLICATION
#=================================================

ynh_script_progression "Starting Open WebUI..."

# Start the systemd service
ynh_systemctl --service="$app" --action="start"

# Wait for the service to be ready
# Open WebUI may need a few seconds to initialize
sleep 10

# Check if service started successfully
if ! ynh_systemctl --service="$app" --action="status" >/dev/null 2>&1; then
    ynh_print_warn "Open WebUI may still be starting up."
    ynh_print_warn "Check logs at: tail -f /var/log/$app/open-webui.log"
fi

#=================================================
# STORE ADMIN USER
#=================================================

# Store the admin username for reference
ynh_app_setting_set --key=admin_user --value="$admin"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of Open WebUI completed!"
ynh_print_info "Open WebUI is now accessible at https://$domain${path%/}"
ynh_print_info "Admin user '$admin' will have admin access via SSO/LDAP."
ynh_print_info "Check logs at: tail -f /var/log/$app/open-webui.log"