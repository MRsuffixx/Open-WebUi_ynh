#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

# Keep this path for calling _common.sh inside the execution's context of backup and restore scripts
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# RESTORE THE APP INSTALLATION DIRECTORY
#=================================================

ynh_script_progression "Restoring the app installation directory..."

# Restore the installation directory (including venv and .env)
ynh_restore "$install_dir"

# Ensure proper ownership
chown -R "$app:$app" "$install_dir"

# Ensure .env has secure permissions
chmod 600 "$install_dir/.env"
chown "$app:$app" "$install_dir/.env"

#=================================================
# RESTORE THE DATA DIRECTORY
#=================================================

ynh_script_progression "Restoring the data directory..."

# Restore the data directory (including SQLite database, models, uploads)
ynh_restore "$data_dir"

# Ensure proper ownership
chown -R "$app:$app" "$data_dir"

#=================================================
# RECREATE LOG DIRECTORY
#=================================================

ynh_script_progression "Creating log directory..."

mkdir -p "/var/log/${app}"
chown -R "$app:$app" "/var/log/${app}"
chmod 755 "/var/log/${app}"

# Restore log files if they were backed up
ynh_restore "/var/log/${app}/" 2>/dev/null || true
chown -R "$app:$app" "/var/log/${app}"

#=================================================
# RESTORE SYSTEM CONFIGURATION
#=================================================

ynh_script_progression "Restoring system configurations..."

# Restore the Nginx configuration (reverse proxy)
ynh_restore "/etc/nginx/conf.d/${domain}.d/${app}.conf"

# Restore the systemd service unit
ynh_restore "/etc/systemd/system/${app}.service"
systemctl enable "${app}.service" --quiet

# Re-add the service to YunoHost's service management
yunohost service add "$app" \
    --description="Open WebUI - Self-hosted AI Interface" \
    --log="/var/log/${app}/open-webui.log" \
    --needs_exposed_ports "$port"

# Restore the logrotate configuration
ynh_restore "/etc/logrotate.d/${app}"

# Restore fail2ban configuration if it was backed up
if ynh_backup_section_enabled; then
    ynh_restore "/etc/fail2ban/jail.d/${app}.conf" 2>/dev/null || true
    ynh_restore "/etc/fail2ban/filter.d/${app}.conf" 2>/dev/null || true
fi

#=================================================
# ENSURE DEPENDENCIES ARE INSTALLED
#=================================================

# Ensure the venv has all required dependencies
# This is important if the venv was recreated or packages are missing
ynh_script_progression "Verifying Python dependencies..."

if [ ! -f "$install_dir/venv/bin/pip" ]; then
    ynh_script_progression "Virtual environment not found, recreating..."
    
    # Recreate the venv
    python3 -m venv "$install_dir/venv"
    
    # Upgrade pip
    "$install_dir/venv/bin/pip" install --upgrade pip wheel setuptools
    
    # Reinstall Open WebUI
    ynh_script_progression "Reinstalling Open WebUI (this may take a while)..."
    "$install_dir/venv/bin/pip" install --no-cache-dir open-webui
else
    # Verify pip is working
    "$install_dir/venv/bin/pip" --version > /dev/null 2>&1 || {
        ynh_script_progression "Pip not working, recreating venv..."
        python3 -m venv "$install_dir/venv"
        "$install_dir/venv/bin/pip" install --upgrade pip wheel setuptools
        "$install_dir/venv/bin/pip" install --no-cache-dir open-webui
    }
fi

#=================================================
# RELOAD SERVICES
#=================================================

ynh_script_progression "Reloading services..."

# Reload Nginx
ynh_systemctl --service="nginx" --action="reload"

# Start the Open WebUI service
ynh_script_progression "Starting Open WebUI..."
ynh_systemctl --service="$app" --action="start"

# Wait for the service to be ready
sleep 5

# Check if service started successfully
if ! ynh_systemctl --service="$app" --action="status" >/dev/null 2>&1; then
    ynh_print_warn "Open WebUI may not be fully started yet."
    ynh_print_warn "Check logs at: tail -f /var/log/${app}/open-webui.log"
else
    ynh_print_info "Open WebUI service is running."
fi

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Restoration of Open WebUI completed successfully!"
ynh_print_info "Open WebUI should be accessible at https://${domain}${path%/}"
ynh_print_info "Check logs at: tail -f /var/log/${app}/open-webui.log"