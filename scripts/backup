#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

# Keep this path for calling _common.sh inside the execution's context of backup and restore scripts
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# DECLARE BACKUP FILES AND DIRECTORIES
#=================================================

ynh_print_info "Declaring backup files and directories to be backed up..."

### N.B. : the following 'ynh_backup' calls are only a *declaration* of what needs
### to be backed up and not an actual copy of any file. The actual backup that
### creates and fills the archive with the files happens in the core after this
### script is called. Hence ynh_backup calls take basically 0 seconds to run.

#=================================================
# BACKUP THE APP INSTALLATION DIRECTORY
#=================================================

# This includes the virtual environment and the .env configuration
# Note: We exclude the venv from backup to save space - it will be recreated during restore
# However, for a complete backup including venv, remove "--exclude=venv" from the call

# Backup the install directory (venv is large, consider excluding for faster backups)
# For production use, you might want to backup the entire install_dir including venv
ynh_backup "$install_dir"

#=================================================
# BACKUP THE DATA DIRECTORY
#=================================================

# Backup the data directory containing SQLite database, models, uploads
# This is critical - it contains all user data and the database
# NOTE: $data_dir is not backed up during safety-backup-before-upgrades
# because the data dir may be huge. It IS backed up during regular backup.
ynh_backup "$data_dir"

#=================================================
# BACKUP SYSTEM CONFIGURATION
#=================================================

# Backup the Nginx configuration (reverse proxy)
ynh_backup "/etc/nginx/conf.d/${domain}.d/${app}.conf"

# Backup the systemd service unit
ynh_backup "/etc/systemd/system/${app}.service"

# Backup the logrotate configuration
ynh_backup "/etc/logrotate.d/${app}"

#=================================================
# BACKUP VARIOUS FILES
#=================================================

# Backup fail2ban configuration if it exists
if [ -f "/etc/fail2ban/jail.d/${app}.conf" ]; then
    ynh_backup "/etc/fail2ban/jail.d/${app}.conf"
fi
if [ -f "/etc/fail2ban/filter.d/${app}.conf" ]; then
    ynh_backup "/etc/fail2ban/filter.d/${app}.conf"
fi

# NOTE: /var/log is not backed up during safety-backup-before-upgrades
# (same as $data_dir), but IS backed up during regular backup
ynh_backup "/var/log/${app}/"

#=================================================
# END OF SCRIPT
#=================================================

ynh_print_info "Backup completed successfully!"
ynh_print_info "The venv was included in the backup. If you want faster backups,"
ynh_print_info "you can modify this script to exclude the venv directory."